---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import DailyQuote from '../components/DailyQuote.astro';
---

<BaseLayout>
  <Hero />
  <DailyQuote />

  <section class="section about" aria-labelledby="about-heading">
    <div class="container about-grid">
      <div class="about-heading">
        <p class="eyebrow">Who we are</p>
        <h2 id="about-heading" class="section-title">
          A student-led <em>awareness</em> initiative
        </h2>
      </div>
      <div class="about-body">
        <p>
          Compassion Review is a student-led awareness and advocacy initiative dedicated to shedding
          light on global humanitarian crises and the roots behind poverty and inequality across
          countries Compassion serves in. Our platform seeks to bring a greater sense of urgency to
          these issues and help people understand why our help and action is needed.
        </p>
        <p>
          Through deep-dive articles, strategic social media advocacy, and transparency-driven
          fundraising, we analyze the systemic barriers facing children in vulnerable regions, from
          disaster relief to rural education gaps. Beyond merely reporting on issues, we actively
          fundraise to fuel Compassion Korea’s verified child-development programs, transforming
          awareness into further tangible impact.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
