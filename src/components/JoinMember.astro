---
// To change the link, edit memberFormUrl in src/config/site.ts
import { site } from '../config/site';
---

<section class="section join-section">
  <div class="container narrow">
    <a class="join-link" href={site.memberFormUrl} target="_blank" rel="noopener noreferrer">
      Join as a Member Now! <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
